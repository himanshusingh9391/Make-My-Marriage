{
  "openapi": "3.1.0",
  "info": {
    "title": "Make My Marriage - Personal invitation and RSVP",
    "version": "1.0.0",
    "description": "Public invitation tokens require no account/login. All writes enforce origin checks when provided. Private link management requires Owner/Admin/Manager wedding membership. Responses are never cacheable."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/weddings/{weddingId}/guests/{guestId}/rsvp-link": {
      "parameters": [
        {
          "name": "weddingId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        },
        {
          "name": "guestId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        }
      ],
      "get": {
        "operationId": "getRsvpLinkState",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "State only; raw token cannot be retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/LinkState"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, token expiry/revocation, scope, deadline, capacity, rate limit, or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrReplaceRsvpLink",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "201": {
            "description": "New 30-day link; previous token invalidated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "active": {
                          "const": true
                        },
                        "expiresAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, token expiry/revocation, scope, deadline, capacity, rate limit, or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeRsvpLink",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Access revoked; responses retained",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "active": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, token expiry/revocation, scope, deadline, capacity, rate limit, or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/guest/invitations/{token}": {
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      ],
      "get": {
        "operationId": "getPersonalInvitation",
        "security": [],
        "responses": {
          "200": {
            "description": "Only this guest and their assigned active events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Invitation"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, token expiry/revocation, scope, deadline, capacity, rate limit, or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveRsvpBatch",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "responses"
                ],
                "properties": {
                  "responses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "description": "Unique event IDs; batch commits atomically.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "eventId",
                        "response"
                      ],
                      "properties": {
                        "eventId": {
                          "type": "string",
                          "pattern": "^[a-fA-F0-9]{24}$"
                        },
                        "response": {
                          "$ref": "#/components/schemas/RsvpResponse"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated personal invitation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Invitation"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, token expiry/revocation, scope, deadline, capacity, rate limit, or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/guest/invitations/{token}/events/{eventId}/rsvp": {
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        {
          "name": "eventId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        }
      ],
      "put": {
        "operationId": "saveEventRsvp",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RsvpResponse"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated personal invitation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Invitation"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, token expiry/revocation, scope, deadline, capacity, rate limit, or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mmm_session"
      }
    },
    "schemas": {
      "LinkState": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "RsvpResponse": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "attendeeCount"
            ],
            "properties": {
              "status": {
                "const": "YES"
              },
              "attendeeCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "guestMessage": {
                "type": "string",
                "maxLength": 1000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "attendeeCount"
            ],
            "properties": {
              "status": {
                "const": "NO"
              },
              "attendeeCount": {
                "const": 0
              },
              "guestMessage": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        ]
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string"
          },
          "weddingName": {
            "type": "string"
          },
          "partnerOneName": {
            "type": "string"
          },
          "partnerTwoName": {
            "type": "string"
          },
          "weddingDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "city": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignedEvent"
            }
          }
        }
      },
      "AssignedEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "venueName": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "dressCode": {
            "type": "string"
          },
          "maxAttendees": {
            "type": "integer",
            "minimum": 1
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "closed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "YES",
              "NO"
            ]
          },
          "attendeeCount": {
            "type": "integer",
            "minimum": 0
          },
          "guestMessage": {
            "type": "string"
          }
        }
      }
    }
  }
}
