{
  "openapi": "3.1.0",
  "info": {
    "title": "Make My Marriage ? Guests",
    "version": "1.0.0",
    "description": "Wedding-scoped Owner/Admin/Manager guest management. Mutations require same-origin session requests; archived weddings are read-only. Saving does not send email."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/weddings/{weddingId}/guests": {
      "parameters": [
        {
          "name": "weddingId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        }
      ],
      "get": {
        "operationId": "listGuests",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "eventId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "rsvpStatus",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/RsvpStatus"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "25 guest groups per page; filters applied before pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "guests": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Guest"
                          }
                        },
                        "total": {
                          "type": "integer"
                        },
                        "page": {
                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, authentication, scope, archived wedding, conflict, or server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createGuest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Guest saved with event assignments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Guest"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, authentication, scope, archived wedding, conflict, or server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/weddings/{weddingId}/guests/{guestId}": {
      "parameters": [
        {
          "name": "weddingId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        },
        {
          "name": "guestId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        }
      ],
      "get": {
        "operationId": "getGuest",
        "responses": {
          "200": {
            "description": "Guest details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Guest"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, authentication, scope, archived wedding, conflict, or server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateGuest",
        "description": "Complete editable form. Selected events are replaced atomically; responded assignments cannot be removed. Stale edits, duplicate email, and attendance conflicts return 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guest updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Guest"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, authentication, scope, archived wedding, conflict, or server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteGuest",
        "description": "Soft delete; revoke invitation; retain RSVP history.",
        "responses": {
          "200": {
            "description": "Guest removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "guestId": {
                          "type": "string",
                          "pattern": "^[a-fA-F0-9]{24}$"
                        },
                        "removed": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Validation, authentication, scope, archived wedding, conflict, or server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mmm_session"
      }
    },
    "schemas": {
      "GuestInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fullName",
          "maxPartySize"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Valid email or empty string; optional."
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "groupName": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "maxPartySize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "eventIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "uniqueItems": true,
            "maxItems": 100
          }
        }
      },
      "GuestUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fullName",
          "maxPartySize",
          "expectedUpdatedAt"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Valid email or empty string; optional."
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "groupName": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "maxPartySize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "eventIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "expectedUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RsvpStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "YES",
          "NO",
          "MIXED"
        ]
      },
      "Guest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Valid email or empty string; optional."
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "groupName": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "maxPartySize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "eventIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rsvpStatus": {
            "$ref": "#/components/schemas/RsvpStatus"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{24}$"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "PENDING",
                    "YES",
                    "NO"
                  ]
                },
                "attendeeCount": {
                  "type": "integer"
                },
                "guestMessage": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
